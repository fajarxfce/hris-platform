HRIS_MIGRATION_PASSWORD=replace-with-a-generated-password
HRIS_DATABASE_PASSWORD=replace-with-a-different-generated-password
HRIS_WORKER_DATABASE_PASSWORD=replace-with-a-third-generated-password
HRIS_DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/hris
HRIS_DATABASE_USER=hris_app
HRIS_BOOTSTRAP_EMAIL=admin@example.com
HRIS_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
# Local HTTP development only; keep true behind production HTTPS.
HRIS_SECURE_COOKIES=false
# Generate a separate 32-byte key and set v1:<base64>. Never commit the real key.
HRIS_IDENTITY_ACTIVE_KEY=v1
HRIS_IDENTITY_KEYS=

# Optional OIDC authorization-code login. Register the callback described in docs/sso.md.
HRIS_OIDC_ENABLED=false
HRIS_PUBLIC_URL=
HRIS_OIDC_ISSUER=
HRIS_OIDC_CLIENT_ID=
HRIS_OIDC_CLIENT_SECRET=
HRIS_OIDC_AUTHORIZATION_URI=
HRIS_OIDC_TOKEN_URI=
HRIS_OIDC_JWK_SET_URI=
HRIS_OIDC_CLIENT_AUTH=client_secret_basic
HRIS_OIDC_ALLOW_LOOPBACK_HTTP=false
