HRIS_MIGRATION_PASSWORD=replace-with-a-generated-password
HRIS_DATABASE_PASSWORD=replace-with-a-different-generated-password
HRIS_WORKER_DATABASE_PASSWORD=replace-with-a-third-generated-password
HRIS_DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/hris
HRIS_DATABASE_USER=hris_app
HRIS_BOOTSTRAP_EMAIL=admin@example.com
HRIS_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
# Local HTTP development only; keep true behind production HTTPS.
HRIS_SECURE_COOKIES=false
# Generate a separate 32-byte key and set v1:<base64>. Never commit the real key.
HRIS_IDENTITY_ACTIVE_KEY=v1
HRIS_IDENTITY_KEYS=

# Dedicated mobile-sync cursor key. Same format, separate key from identity.
# Leave empty to disable cursor issuance; see docs/synchronization.md.
HRIS_SYNC_ACTIVE_KEY=v1
HRIS_SYNC_KEYS=

# Optional OIDC authorization-code login. Register the callback described in docs/sso.md.
HRIS_OIDC_ENABLED=false
HRIS_PUBLIC_URL=
HRIS_OIDC_ISSUER=
HRIS_OIDC_CLIENT_ID=
HRIS_OIDC_CLIENT_SECRET=
HRIS_OIDC_AUTHORIZATION_URI=
HRIS_OIDC_TOKEN_URI=
HRIS_OIDC_JWK_SET_URI=
HRIS_OIDC_CLIENT_AUTH=client_secret_basic
HRIS_OIDC_ALLOW_LOOPBACK_HTTP=false

# SMTP delivery is disabled until provider credentials and HRIS_PUBLIC_URL are configured.
HRIS_MAIL_ENABLED=false
HRIS_MAIL_HOST=
HRIS_MAIL_PORT=587
HRIS_MAIL_FROM=
HRIS_MAIL_USERNAME=
HRIS_MAIL_PASSWORD=
HRIS_MAIL_TRANSPORT=STARTTLS
HRIS_MAIL_ALLOW_LOOPBACK_PLAINTEXT=false
HRIS_AUTH_LINKS_ALLOW_LOOPBACK_HTTP=false

# Private S3-compatible storage and its bounded cleanup worker.
HRIS_STORAGE_ENABLED=false
HRIS_STORAGE_ENDPOINT=
HRIS_STORAGE_REGION=garage
HRIS_STORAGE_BUCKET=
HRIS_STORAGE_ACCESS_KEY=
HRIS_STORAGE_SECRET_KEY=
HRIS_STORAGE_ALLOW_PLAINTEXT=false

# Private ClamAV endpoint; publishing documents requires successful content inspection.
HRIS_DOCUMENT_SCANNER_ENABLED=false
HRIS_DOCUMENT_SCANNER_HOST=antivirus
HRIS_DOCUMENT_SCANNER_PORT=3310

# Optional private document services in compose.documents.yml. Use a separate 32-byte hex key.
HRIS_GARAGE_RPC_SECRET=
