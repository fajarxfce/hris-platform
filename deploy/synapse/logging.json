{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "safe": {
      "()": "hris_push_logging.BoundedRedactingFormatter",
      "format": "%(asctime)sZ %(levelname)s %(name)s %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "safe",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "synapse": {"level": "INFO", "handlers": [], "propagate": true},
    "twisted": {"level": "INFO", "handlers": [], "propagate": true}
  },
  "root": {"level": "INFO", "handlers": ["console"]}
}
